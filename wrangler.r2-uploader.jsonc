{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "clawsembly-r2-uploader",
  "main": "./worker/r2-uploader.mjs",
  "compatibility_date": "2026-07-29",
  "workers_dev": true,
  "r2_buckets": [
    {
      "binding": "RUNTIME_BUCKET",
      "bucket_name": "clawsembly-kernel-artifacts"
    }
  ]
}
