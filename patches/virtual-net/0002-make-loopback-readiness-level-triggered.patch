+#[cfg(test)]
+mod tests {
+    use super::SocketBuffer;
+    use crate::NetworkError;
+    use std::sync::{
+        atomic::{AtomicUsize, Ordering},
+        Arc,
+    };
+    use std::task::{Context, Poll, Wake, Waker};
+
+    #[derive(Debug, Default)]
+    struct WakeCounter(AtomicUsize);
+
+    impl Wake for WakeCounter {
+        fn wake(self: Arc<Self>) {
+            self.0.fetch_add(1, Ordering::SeqCst);
+        }
+
+        fn wake_by_ref(self: &Arc<Self>) {
+            self.0.fetch_add(1, Ordering::SeqCst);
+        }
+    }
+
+    fn counting_waker() -> (Arc<WakeCounter>, Waker) {
+        let counter = Arc::new(WakeCounter::default());
+        let waker = Waker::from(counter.clone());
+        (counter, waker)
+    }
+
+    #[test]
+    fn write_readiness_remains_level_triggered_until_the_buffer_is_full() {
+        let buffer = SocketBuffer::new(4);
+        let (_, waker) = counting_waker();
+        let mut context = Context::from_waker(&waker);
+
+        assert!(matches!(
+            buffer.poll_write_ready(&mut context),
+            Poll::Ready(Ok(4))
+        ));
+        assert!(matches!(
+            buffer.poll_write_ready(&mut context),
+            Poll::Ready(Ok(4))
+        ));
+
+        assert_eq!(buffer.try_send(b"full", false, None), Ok(4));
+        assert!(matches!(
+            buffer.poll_write_ready(&mut context),
+            Poll::Pending
+        ));
+    }
+
+    #[test]
+    fn partial_send_wakes_a_waiting_reader() {
+        let buffer = SocketBuffer::new(2);
+        let (counter, waker) = counting_waker();
+        let mut context = Context::from_waker(&waker);
+
+        assert!(matches!(
+            buffer.poll_read_ready(&mut context),
+            Poll::Pending
+        ));
+        assert_eq!(buffer.try_send(b"long", false, None), Ok(2));
+        assert_eq!(counter.0.load(Ordering::SeqCst), 1);
+        assert!(matches!(
+            buffer.poll_read_ready(&mut context),
+            Poll::Ready(Ok(2))
+        ));
+        assert_eq!(
+            buffer.try_send(b"x", false, None),
+            Err(NetworkError::WouldBlock)
+        );
+    }
+}
