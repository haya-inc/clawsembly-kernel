+napi_value DatabaseEnableLoadExtension(napi_env env, napi_callback_info info) {
+  size_t argc = 1;
+  napi_value argv[1] = {nullptr};
+  napi_value self = nullptr;
+  if (napi_get_cb_info(env, info, &argc, argv, &self, nullptr) != napi_ok ||
+      argc < 1 || argv[0] == nullptr) {
+    napi_throw_type_error(
+        env, "ERR_INVALID_ARG_TYPE",
+        "DatabaseSync.enableLoadExtension requires a boolean");
+    return nullptr;
+  }
+  if (UnwrapDatabase(env, self) == nullptr) return nullptr;
+  bool enabled = false;
+  if (napi_get_value_bool(env, argv[0], &enabled) != napi_ok) {
+    napi_throw_type_error(
+        env, "ERR_INVALID_ARG_TYPE",
+        "DatabaseSync.enableLoadExtension requires a boolean");
+    return nullptr;
+  }
+  if (enabled) return ExtensionUnavailable(env, info);
+  return Undefined(env);
+}
