diff --git i/src/internal_binding/binding_sqlite.cc w/src/internal_binding/binding_sqlite.cc
new file mode 100644
index 0000000000000000000000000000000000000000..c79285c956ec1e790c80fa2fbf788f45d1395a98
--- /dev/null
+++ w/src/internal_binding/binding_sqlite.cc
@@ -0,0 +1,1035 @@
+#include "internal_binding/binding_initializers.h"
+
+#if defined(EDGE_HAS_SQLITE)
+
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+#include <limits>
+#include <string>
+#include <unordered_set>
+#include <vector>
+
+#include <sqlite3.h>
+
+#include "internal_binding/helpers.h"
+
+namespace internal_binding {
+namespace {
+
+struct BindingState {
+  napi_ref database_constructor = nullptr;
+  napi_ref statement_constructor = nullptr;
+};
+
+struct StatementHandle;
+
+struct DatabaseHandle {
+  BindingState* binding = nullptr;
+  sqlite3* database = nullptr;
+  std::unordered_set<StatementHandle*> statements;
+};
+
+struct StatementHandle {
+  DatabaseHandle* owner = nullptr;
+  sqlite3_stmt* statement = nullptr;
+  napi_ref owner_reference = nullptr;
+};
+
+std::string ValueToUtf8(napi_env env, napi_value value) {
+  if (value == nullptr) return {};
+  size_t length = 0;
+  if (napi_get_value_string_utf8(env, value, nullptr, 0, &length) != napi_ok) {
+    return {};
+  }
+  std::string result(length + 1, '\0');
+  size_t copied = 0;
+  if (napi_get_value_string_utf8(
+          env, value, result.data(), result.size(), &copied) != napi_ok) {
+    return {};
+  }
+  result.resize(copied);
+  return result;
+}
+
+napi_value Null(napi_env env) {
+  napi_value value = nullptr;
+  napi_get_null(env, &value);
+  return value;
+}
+
+bool IsNull(napi_env env, napi_value value) {
+  if (value == nullptr) return false;
+  napi_value null_value = Null(env);
+  bool equal = false;
+  return null_value != nullptr &&
+         napi_strict_equals(env, value, null_value, &equal) == napi_ok &&
+         equal;
+}
+
+void ThrowSqliteError(napi_env env, sqlite3* database, int code,
+                      const char* context) {
+  const char* detail = database != nullptr
+                           ? sqlite3_errmsg(database)
+                           : sqlite3_errstr(code);
+  std::string message = context != nullptr ? context : "SQLite error";
+  if (detail != nullptr && *detail != '\0') {
+    message.append(": ");
+    message.append(detail);
+  }
+  napi_throw_error(env, "ERR_SQLITE_ERROR", message.c_str());
+}
+
+void ThrowInvalidState(napi_env env, const char* message) {
+  napi_throw_error(env, "ERR_INVALID_STATE", message);
+}
+
+bool GetNamedBool(napi_env env, napi_value object, const char* name,
+                  bool default_value, bool* result) {
+  if (result == nullptr) return false;
+  *result = default_value;
+  if (object == nullptr) return true;
+  bool has = false;
+  if (napi_has_named_property(env, object, name, &has) != napi_ok) return false;
+  if (!has) return true;
+  napi_value value = nullptr;
+  if (napi_get_named_property(env, object, name, &value) != napi_ok ||
+      value == nullptr) {
+    return false;
+  }
+  return napi_get_value_bool(env, value, result) == napi_ok;
+}
+
+bool GetNamedInt32(napi_env env, napi_value object, const char* name,
+                   int32_t default_value, int32_t* result) {
+  if (result == nullptr) return false;
+  *result = default_value;
+  if (object == nullptr) return true;
+  bool has = false;
+  if (napi_has_named_property(env, object, name, &has) != napi_ok) return false;
+  if (!has) return true;
+  napi_value value = nullptr;
+  if (napi_get_named_property(env, object, name, &value) != napi_ok ||
+      value == nullptr) {
+    return false;
+  }
+  return napi_get_value_int32(env, value, result) == napi_ok;
+}
+
+DatabaseHandle* UnwrapDatabase(napi_env env, napi_value self,
+                               bool require_open = true) {
+  void* data = nullptr;
+  if (self == nullptr || napi_unwrap(env, self, &data) != napi_ok ||
+      data == nullptr) {
+    ThrowInvalidState(env, "Invalid DatabaseSync receiver");
+    return nullptr;
+  }
+  auto* handle = static_cast<DatabaseHandle*>(data);
+  if (require_open && handle->database == nullptr) {
+    ThrowInvalidState(env, "The database is not open");
+    return nullptr;
+  }
+  return handle;
+}
+
+StatementHandle* UnwrapStatement(napi_env env, napi_value self) {
+  void* data = nullptr;
+  if (self == nullptr || napi_unwrap(env, self, &data) != napi_ok ||
+      data == nullptr) {
+    ThrowInvalidState(env, "Invalid StatementSync receiver");
+    return nullptr;
+  }
+  auto* handle = static_cast<StatementHandle*>(data);
+  if (handle->statement == nullptr || handle->owner == nullptr ||
+      handle->owner->database == nullptr) {
+    ThrowInvalidState(env, "The statement's database is not open");
+    return nullptr;
+  }
+  return handle;
+}
+
+void DetachStatement(napi_env env, StatementHandle* handle) {
+  if (handle == nullptr) return;
+  if (handle->owner != nullptr) {
+    handle->owner->statements.erase(handle);
+    handle->owner = nullptr;
+  }
+  if (handle->statement != nullptr) {
+    sqlite3_finalize(handle->statement);
+    handle->statement = nullptr;
+  }
+  if (handle->owner_reference != nullptr) {
+    napi_delete_reference(env, handle->owner_reference);
+    handle->owner_reference = nullptr;
+  }
+}
+
+void FinalizeDatabaseStatements(napi_env env, DatabaseHandle* handle) {
+  if (handle == nullptr) return;
+  while (!handle->statements.empty()) {
+    DetachStatement(env, *handle->statements.begin());
+  }
+}
+
+void DatabaseFinalize(napi_env env, void* data, void*) {
+  auto* handle = static_cast<DatabaseHandle*>(data);
+  if (handle == nullptr) return;
+  FinalizeDatabaseStatements(env, handle);
+  if (handle->database != nullptr) {
+    sqlite3_close_v2(handle->database);
+    handle->database = nullptr;
+  }
+  delete handle;
+}
+
+void StatementFinalize(napi_env env, void* data, void*) {
+  auto* handle = static_cast<StatementHandle*>(data);
+  if (handle == nullptr) return;
+  DetachStatement(env, handle);
+  delete handle;
+}
+
+void BindingFinalize(napi_env env, void* data, void*) {
+  auto* state = static_cast<BindingState*>(data);
+  if (state == nullptr) return;
+  if (state->database_constructor != nullptr) {
+    napi_delete_reference(env, state->database_constructor);
+  }
+  if (state->statement_constructor != nullptr) {
+    napi_delete_reference(env, state->statement_constructor);
+  }
+  delete state;
+}
+
+bool IsByteArray(napi_env env, napi_value value) {
+  bool is_buffer = false;
+  if (napi_is_buffer(env, value, &is_buffer) == napi_ok && is_buffer) {
+    return true;
+  }
+  bool is_typed_array = false;
+  if (napi_is_typedarray(env, value, &is_typed_array) != napi_ok ||
+      !is_typed_array) {
+    return false;
+  }
+  napi_typedarray_type type = napi_int8_array;
+  size_t length = 0;
+  void* data = nullptr;
+  napi_value array_buffer = nullptr;
+  size_t byte_offset = 0;
+  return napi_get_typedarray_info(env, value, &type, &length, &data,
+                                  &array_buffer, &byte_offset) == napi_ok &&
+         (type == napi_uint8_array || type == napi_uint8_clamped_array);
+}
+
+bool BindByteArray(napi_env env, sqlite3_stmt* statement, int index,
+                   napi_value value) {
+  bool is_buffer = false;
+  if (napi_is_buffer(env, value, &is_buffer) == napi_ok && is_buffer) {
+    void* data = nullptr;
+    size_t length = 0;
+    if (napi_get_buffer_info(env, value, &data, &length) != napi_ok) {
+      return false;
+    }
+    return sqlite3_bind_blob64(statement, index, data, length,
+                               SQLITE_TRANSIENT) == SQLITE_OK;
+  }
+
+  napi_typedarray_type type = napi_int8_array;
+  size_t length = 0;
+  void* data = nullptr;
+  napi_value array_buffer = nullptr;
+  size_t byte_offset = 0;
+  if (napi_get_typedarray_info(env, value, &type, &length, &data,
+                               &array_buffer, &byte_offset) != napi_ok ||
+      (type != napi_uint8_array && type != napi_uint8_clamped_array)) {
+    return false;
+  }
+  return sqlite3_bind_blob64(statement, index, data, length,
+                             SQLITE_TRANSIENT) == SQLITE_OK;
+}
+
+bool BindValue(napi_env env, sqlite3_stmt* statement, int index,
+               napi_value value) {
+  if (value == nullptr || IsNull(env, value)) {
+    return sqlite3_bind_null(statement, index) == SQLITE_OK;
+  }
+  napi_valuetype type = napi_undefined;
+  if (napi_typeof(env, value, &type) != napi_ok) return false;
+  switch (type) {
+    case napi_number: {
+      double number = 0;
+      if (napi_get_value_double(env, value, &number) != napi_ok) return false;
+      if (std::isfinite(number) && std::trunc(number) == number &&
+          number >= static_cast<double>(std::numeric_limits<int64_t>::min()) &&
+          number <= static_cast<double>(std::numeric_limits<int64_t>::max())) {
+        return sqlite3_bind_int64(statement, index,
+                                  static_cast<int64_t>(number)) == SQLITE_OK;
+      }
+      return sqlite3_bind_double(statement, index, number) == SQLITE_OK;
+    }
+    case napi_bigint: {
+      int64_t integer = 0;
+      bool lossless = false;
+      if (napi_get_value_bigint_int64(env, value, &integer, &lossless) !=
+              napi_ok ||
+          !lossless) {
+        napi_throw_range_error(env, "ERR_OUT_OF_RANGE",
+                               "SQLite bigint parameter is outside int64");
+        return false;
+      }
+      return sqlite3_bind_int64(statement, index, integer) == SQLITE_OK;
+    }
+    case napi_string: {
+      const std::string text = ValueToUtf8(env, value);
+      return sqlite3_bind_text64(statement, index, text.data(), text.size(),
+                                 SQLITE_TRANSIENT, SQLITE_UTF8) == SQLITE_OK;
+    }
+    case napi_object:
+      if (IsByteArray(env, value)) {
+        return BindByteArray(env, statement, index, value);
+      }
+      break;
+    default:
+      break;
+  }
+  napi_throw_type_error(
+      env, "ERR_INVALID_ARG_TYPE",
+      "SQLite parameters must be null, numbers, bigints, strings, or Uint8Array");
+  return false;
+}
+
+int FindNamedParameter(sqlite3_stmt* statement, const std::string& name) {
+  int index = sqlite3_bind_parameter_index(statement, name.c_str());
+  if (index != 0 || name.empty() ||
+      name[0] == ':' || name[0] == '@' || name[0] == '$') {
+    return index;
+  }
+  for (const char prefix : {':', '@', '$'}) {
+    const std::string candidate = std::string(1, prefix) + name;
+    index = sqlite3_bind_parameter_index(statement, candidate.c_str());
+    if (index != 0) return index;
+  }
+  return 0;
+}
+
+bool BindNamed(napi_env env, sqlite3_stmt* statement, napi_value object) {
+  napi_value names = nullptr;
+  if (napi_get_property_names(env, object, &names) != napi_ok ||
+      names == nullptr) {
+    return false;
+  }
+  uint32_t length = 0;
+  if (napi_get_array_length(env, names, &length) != napi_ok) return false;
+  for (uint32_t offset = 0; offset < length; ++offset) {
+    napi_value key = nullptr;
+    napi_value value = nullptr;
+    if (napi_get_element(env, names, offset, &key) != napi_ok ||
+        key == nullptr ||
+        napi_get_property(env, object, key, &value) != napi_ok ||
+        value == nullptr) {
+      return false;
+    }
+    napi_value string_key = nullptr;
+    if (napi_coerce_to_string(env, key, &string_key) != napi_ok ||
+        string_key == nullptr) {
+      return false;
+    }
+    const std::string name = ValueToUtf8(env, string_key);
+    const int index = FindNamedParameter(statement, name);
+    if (index == 0) {
+      const std::string message =
+          "Unknown named SQLite parameter: " + name;
+      napi_throw_range_error(env, "ERR_INVALID_STATE", message.c_str());
+      return false;
+    }
+    if (!BindValue(env, statement, index, value)) return false;
+  }
+  return true;
+}
+
+bool BindArguments(napi_env env, sqlite3_stmt* statement, size_t argc,
+                   napi_value* argv) {
+  sqlite3_reset(statement);
+  sqlite3_clear_bindings(statement);
+  if (argc == 1 && argv[0] != nullptr) {
+    napi_valuetype type = napi_undefined;
+    if (napi_typeof(env, argv[0], &type) == napi_ok &&
+        type == napi_object && !IsNull(env, argv[0]) &&
+        !IsByteArray(env, argv[0])) {
+      return BindNamed(env, statement, argv[0]);
+    }
+  }
+  const int expected = sqlite3_bind_parameter_count(statement);
+  if (argc > static_cast<size_t>(expected)) {
+    napi_throw_range_error(env, "ERR_INVALID_STATE",
+                           "Too many positional SQLite parameters");
+    return false;
+  }
+  for (size_t index = 0; index < argc; ++index) {
+    if (!BindValue(env, statement, static_cast<int>(index + 1), argv[index])) {
+      return false;
+    }
+  }
+  return true;
+}
+
+napi_value ColumnValue(napi_env env, sqlite3_stmt* statement, int column) {
+  switch (sqlite3_column_type(statement, column)) {
+    case SQLITE_INTEGER: {
+      const sqlite3_int64 value = sqlite3_column_int64(statement, column);
+      constexpr sqlite3_int64 kMaxSafeInteger = 9007199254740991LL;
+      constexpr sqlite3_int64 kMinSafeInteger = -9007199254740991LL;
+      napi_value result = nullptr;
+      if (value >= kMinSafeInteger && value <= kMaxSafeInteger) {
+        napi_create_int64(env, value, &result);
+      } else {
+        napi_create_bigint_int64(env, value, &result);
+      }
+      return result;
+    }
+    case SQLITE_FLOAT: {
+      napi_value result = nullptr;
+      napi_create_double(env, sqlite3_column_double(statement, column),
+                         &result);
+      return result;
+    }
+    case SQLITE_TEXT: {
+      const auto* text = sqlite3_column_text(statement, column);
+      const int bytes = sqlite3_column_bytes(statement, column);
+      napi_value result = nullptr;
+      napi_create_string_utf8(env, reinterpret_cast<const char*>(text),
+                              static_cast<size_t>(bytes), &result);
+      return result;
+    }
+    case SQLITE_BLOB: {
+      const void* bytes = sqlite3_column_blob(statement, column);
+      const int length = sqlite3_column_bytes(statement, column);
+      napi_value result = nullptr;
+      void* copied = nullptr;
+      napi_create_buffer_copy(env, static_cast<size_t>(length), bytes,
+                              &copied, &result);
+      return result;
+    }
+    case SQLITE_NULL:
+    default:
+      return Null(env);
+  }
+}
+
+napi_value CurrentRow(napi_env env, sqlite3_stmt* statement) {
+  napi_value row = nullptr;
+  if (napi_create_object(env, &row) != napi_ok || row == nullptr) {
+    return nullptr;
+  }
+  const int columns = sqlite3_column_count(statement);
+  for (int column = 0; column < columns; ++column) {
+    const char* name = sqlite3_column_name(statement, column);
+    napi_value key = nullptr;
+    napi_value value = ColumnValue(env, statement, column);
+    if (name == nullptr || value == nullptr ||
+        napi_create_string_utf8(env, name, NAPI_AUTO_LENGTH, &key) != napi_ok ||
+        key == nullptr ||
+        napi_set_property(env, row, key, value) != napi_ok) {
+      return nullptr;
+    }
+  }
+  return row;
+}
+
+bool ReadStatementCall(napi_env env, napi_callback_info info,
+                       StatementHandle** handle, size_t* argc,
+                       napi_value* argv, size_t capacity) {
+  napi_value self = nullptr;
+  *argc = capacity;
+  if (napi_get_cb_info(env, info, argc, argv, &self, nullptr) != napi_ok) {
+    return false;
+  }
+  *handle = UnwrapStatement(env, self);
+  return *handle != nullptr && BindArguments(
+      env, (*handle)->statement, *argc, argv);
+}
+
+napi_value StatementGet(napi_env env, napi_callback_info info) {
+  constexpr size_t kMaxArguments = 64;
+  size_t argc = kMaxArguments;
+  napi_value argv[kMaxArguments] = {};
+  StatementHandle* handle = nullptr;
+  if (!ReadStatementCall(
+          env, info, &handle, &argc, argv, kMaxArguments)) {
+    return nullptr;
+  }
+  const int result = sqlite3_step(handle->statement);
+  napi_value row = nullptr;
+  if (result == SQLITE_ROW) {
+    row = CurrentRow(env, handle->statement);
+  } else if (result == SQLITE_DONE) {
+    row = Undefined(env);
+  } else {
+    ThrowSqliteError(env, handle->owner->database, result,
+                     "SQLite statement failed");
+  }
+  sqlite3_reset(handle->statement);
+  return row;
+}
+
+napi_value StatementAll(napi_env env, napi_callback_info info) {
+  constexpr size_t kMaxArguments = 64;
+  size_t argc = kMaxArguments;
+  napi_value argv[kMaxArguments] = {};
+  StatementHandle* handle = nullptr;
+  if (!ReadStatementCall(
+          env, info, &handle, &argc, argv, kMaxArguments)) {
+    return nullptr;
+  }
+  napi_value rows = nullptr;
+  if (napi_create_array(env, &rows) != napi_ok || rows == nullptr) {
+    return nullptr;
+  }
+  uint32_t index = 0;
+  int result = SQLITE_OK;
+  while ((result = sqlite3_step(handle->statement)) == SQLITE_ROW) {
+    napi_value row = CurrentRow(env, handle->statement);
+    if (row == nullptr ||
+        napi_set_element(env, rows, index++, row) != napi_ok) {
+      sqlite3_reset(handle->statement);
+      return nullptr;
+    }
+  }
+  sqlite3_reset(handle->statement);
+  if (result != SQLITE_DONE) {
+    ThrowSqliteError(env, handle->owner->database, result,
+                     "SQLite statement failed");
+    return nullptr;
+  }
+  return rows;
+}
+
+napi_value StatementRun(napi_env env, napi_callback_info info) {
+  constexpr size_t kMaxArguments = 64;
+  size_t argc = kMaxArguments;
+  napi_value argv[kMaxArguments] = {};
+  StatementHandle* handle = nullptr;
+  if (!ReadStatementCall(
+          env, info, &handle, &argc, argv, kMaxArguments)) {
+    return nullptr;
+  }
+  int result = SQLITE_OK;
+  while ((result = sqlite3_step(handle->statement)) == SQLITE_ROW) {
+  }
+  sqlite3_reset(handle->statement);
+  if (result != SQLITE_DONE) {
+    ThrowSqliteError(env, handle->owner->database, result,
+                     "SQLite statement failed");
+    return nullptr;
+  }
+  napi_value output = nullptr;
+  napi_value changes = nullptr;
+  napi_value last_insert_rowid = nullptr;
+  if (napi_create_object(env, &output) != napi_ok ||
+      napi_create_int64(
+          env, sqlite3_changes64(handle->owner->database), &changes) !=
+          napi_ok ||
+      napi_create_int64(
+          env, sqlite3_last_insert_rowid(handle->owner->database),
+          &last_insert_rowid) != napi_ok ||
+      napi_set_named_property(env, output, "changes", changes) != napi_ok ||
+      napi_set_named_property(
+          env, output, "lastInsertRowid", last_insert_rowid) != napi_ok) {
+    return nullptr;
+  }
+  return output;
+}
+
+napi_value StatementIterate(napi_env env, napi_callback_info info) {
+  napi_value rows = StatementAll(env, info);
+  if (rows == nullptr) return nullptr;
+  napi_value global = GetGlobal(env);
+  napi_value symbol = nullptr;
+  napi_value iterator_key = nullptr;
+  napi_value iterator_function = nullptr;
+  napi_value iterator = nullptr;
+  if (global == nullptr ||
+      napi_get_named_property(env, global, "Symbol", &symbol) != napi_ok ||
+      symbol == nullptr ||
+      napi_get_named_property(env, symbol, "iterator", &iterator_key) !=
+          napi_ok ||
+      iterator_key == nullptr ||
+      napi_get_property(env, rows, iterator_key, &iterator_function) !=
+          napi_ok ||
+      iterator_function == nullptr ||
+      napi_call_function(
+          env, rows, iterator_function, 0, nullptr, &iterator) != napi_ok) {
+    return nullptr;
+  }
+  return iterator;
+}
+
+bool SetNullableString(napi_env env, napi_value object, const char* key,
+                       const char* value) {
+  napi_value result = nullptr;
+  if (value == nullptr) {
+    result = Null(env);
+  } else if (napi_create_string_utf8(
+                 env, value, NAPI_AUTO_LENGTH, &result) != napi_ok) {
+    return false;
+  }
+  return result != nullptr &&
+         napi_set_named_property(env, object, key, result) == napi_ok;
+}
+
+napi_value StatementColumns(napi_env env, napi_callback_info info) {
+  size_t argc = 0;
+  napi_value self = nullptr;
+  if (napi_get_cb_info(env, info, &argc, nullptr, &self, nullptr) != napi_ok) {
+    return nullptr;
+  }
+  StatementHandle* handle = UnwrapStatement(env, self);
+  if (handle == nullptr) return nullptr;
+  const int count = sqlite3_column_count(handle->statement);
+  napi_value columns = nullptr;
+  if (napi_create_array_with_length(
+          env, static_cast<size_t>(count), &columns) != napi_ok ||
+      columns == nullptr) {
+    return nullptr;
+  }
+  for (int index = 0; index < count; ++index) {
+    napi_value metadata = nullptr;
+    if (napi_create_object(env, &metadata) != napi_ok ||
+        metadata == nullptr ||
+        !SetNullableString(env, metadata, "column",
+                           sqlite3_column_name(handle->statement, index)) ||
+        !SetNullableString(env, metadata, "database",
+                           sqlite3_column_database_name(
+                               handle->statement, index)) ||
+        !SetNullableString(env, metadata, "name",
+                           sqlite3_column_origin_name(
+                               handle->statement, index)) ||
+        !SetNullableString(env, metadata, "origin",
+                           sqlite3_column_origin_name(
+                               handle->statement, index)) ||
+        !SetNullableString(env, metadata, "table",
+                           sqlite3_column_table_name(
+                               handle->statement, index)) ||
+        !SetNullableString(env, metadata, "type",
+                           sqlite3_column_decltype(
+                               handle->statement, index)) ||
+        napi_set_element(
+            env, columns, static_cast<uint32_t>(index), metadata) != napi_ok) {
+      return nullptr;
+    }
+  }
+  return columns;
+}
+
+napi_value StatementCtor(napi_env env, napi_callback_info info) {
+  size_t argc = 1;
+  napi_value argv[1] = {nullptr};
+  napi_value self = nullptr;
+  if (napi_get_cb_info(env, info, &argc, argv, &self, nullptr) != napi_ok ||
+      self == nullptr || argc != 1 || argv[0] == nullptr) {
+    napi_throw_type_error(
+        env, "ERR_ILLEGAL_CONSTRUCTOR",
+        "StatementSync cannot be constructed directly");
+    return nullptr;
+  }
+  void* data = nullptr;
+  if (napi_get_value_external(env, argv[0], &data) != napi_ok ||
+      data == nullptr) {
+    napi_throw_type_error(
+        env, "ERR_ILLEGAL_CONSTRUCTOR",
+        "StatementSync cannot be constructed directly");
+    return nullptr;
+  }
+  auto* handle = static_cast<StatementHandle*>(data);
+  if (napi_wrap(env, self, handle, StatementFinalize, nullptr, nullptr) !=
+      napi_ok) {
+    StatementFinalize(env, handle, nullptr);
+    return nullptr;
+  }
+  return self;
+}
+
+napi_value DatabaseCtor(napi_env env, napi_callback_info info) {
+  size_t argc = 2;
+  napi_value argv[2] = {nullptr, nullptr};
+  napi_value self = nullptr;
+  void* callback_data = nullptr;
+  if (napi_get_cb_info(
+          env, info, &argc, argv, &self, &callback_data) != napi_ok ||
+      self == nullptr || argc < 1 || argv[0] == nullptr) {
+    napi_throw_type_error(
+        env, "ERR_INVALID_ARG_TYPE",
+        "DatabaseSync requires a database path");
+    return nullptr;
+  }
+  napi_valuetype path_type = napi_undefined;
+  if (napi_typeof(env, argv[0], &path_type) != napi_ok ||
+      path_type != napi_string) {
+    napi_throw_type_error(
+        env, "ERR_INVALID_ARG_TYPE",
+        "DatabaseSync path must be a string");
+    return nullptr;
+  }
+  napi_value options = argc >= 2 ? argv[1] : nullptr;
+  if (options != nullptr && !IsNull(env, options)) {
+    napi_valuetype options_type = napi_undefined;
+    if (napi_typeof(env, options, &options_type) != napi_ok ||
+        options_type != napi_object) {
+      napi_throw_type_error(
+          env, "ERR_INVALID_ARG_TYPE",
+          "DatabaseSync options must be an object");
+      return nullptr;
+    }
+  } else {
+    options = nullptr;
+  }
+
+  bool open = true;
+  bool read_only = false;
+  bool allow_extension = false;
+  bool enable_foreign_keys = true;
+  bool defensive = true;
+  int32_t timeout = 0;
+  if (!GetNamedBool(env, options, "open", true, &open) ||
+      !GetNamedBool(env, options, "readOnly", false, &read_only) ||
+      !GetNamedBool(
+          env, options, "allowExtension", false, &allow_extension) ||
+      !GetNamedBool(env, options, "enableForeignKeyConstraints", true,
+                    &enable_foreign_keys) ||
+      !GetNamedBool(env, options, "defensive", true, &defensive) ||
+      !GetNamedInt32(env, options, "timeout", 0, &timeout)) {
+    napi_throw_type_error(
+        env, "ERR_INVALID_ARG_TYPE",
+        "Invalid DatabaseSync option");
+    return nullptr;
+  }
+  if (!open) {
+    napi_throw_error(
+        env, "ERR_FEATURE_UNAVAILABLE",
+        "DatabaseSync open:false is not implemented");
+    return nullptr;
+  }
+  if (allow_extension) {
+    napi_throw_error(
+        env, "ERR_FEATURE_UNAVAILABLE",
+        "SQLite extension loading is disabled");
+    return nullptr;
+  }
+  if (timeout < 0) {
+    napi_throw_range_error(
+        env, "ERR_OUT_OF_RANGE",
+        "DatabaseSync timeout must be non-negative");
+    return nullptr;
+  }
+
+  const std::string filename = ValueToUtf8(env, argv[0]);
+  auto* handle = new DatabaseHandle();
+  handle->binding = static_cast<BindingState*>(callback_data);
+  const int flags =
+      (read_only ? SQLITE_OPEN_READONLY
+                 : SQLITE_OPEN_READWRITE | SQLITE_OPEN_CREATE) |
+      SQLITE_OPEN_URI;
+  const int result =
+      sqlite3_open_v2(filename.c_str(), &handle->database, flags, nullptr);
+  if (result != SQLITE_OK) {
+    ThrowSqliteError(env, handle->database, result, "Could not open database");
+    if (handle->database != nullptr) sqlite3_close_v2(handle->database);
+    delete handle;
+    return nullptr;
+  }
+  sqlite3_extended_result_codes(handle->database, 1);
+  if (timeout > 0) sqlite3_busy_timeout(handle->database, timeout);
+#if defined(EDGE_SQLITE_EXCLUSIVE_LOCKING)
+  {
+    char* error = nullptr;
+    const int locking_mode_result = sqlite3_exec(
+        handle->database, "PRAGMA locking_mode = EXCLUSIVE",
+        nullptr, nullptr, &error);
+    if (locking_mode_result != SQLITE_OK) {
+      std::string message =
+          "Could not enable SQLite exclusive locking mode";
+      if (error != nullptr) {
+        message.append(": ");
+        message.append(error);
+        sqlite3_free(error);
+      }
+      napi_throw_error(env, "ERR_SQLITE_ERROR", message.c_str());
+      DatabaseFinalize(env, handle, nullptr);
+      return nullptr;
+    }
+  }
+#endif
+  if (sqlite3_db_config(handle->database, SQLITE_DBCONFIG_DEFENSIVE,
+                        defensive ? 1 : 0, nullptr) != SQLITE_OK) {
+    ThrowSqliteError(env, handle->database, sqlite3_errcode(handle->database),
+                     "Could not configure SQLite defensive mode");
+    DatabaseFinalize(env, handle, nullptr);
+    return nullptr;
+  }
+  if (enable_foreign_keys) {
+    char* error = nullptr;
+    const int foreign_keys_result = sqlite3_exec(
+        handle->database, "PRAGMA foreign_keys = ON", nullptr, nullptr, &error);
+    if (foreign_keys_result != SQLITE_OK) {
+      std::string message = "Could not enable SQLite foreign keys";
+      if (error != nullptr) {
+        message.append(": ");
+        message.append(error);
+        sqlite3_free(error);
+      }
+      napi_throw_error(env, "ERR_SQLITE_ERROR", message.c_str());
+      DatabaseFinalize(env, handle, nullptr);
+      return nullptr;
+    }
+  }
+  if (napi_wrap(env, self, handle, DatabaseFinalize, nullptr, nullptr) !=
+      napi_ok) {
+    DatabaseFinalize(env, handle, nullptr);
+    return nullptr;
+  }
+  return self;
+}
+
+napi_value DatabaseIsOpen(napi_env env, napi_callback_info info) {
+  size_t argc = 0;
+  napi_value self = nullptr;
+  if (napi_get_cb_info(env, info, &argc, nullptr, &self, nullptr) != napi_ok) {
+    return nullptr;
+  }
+  DatabaseHandle* handle = UnwrapDatabase(env, self, false);
+  if (handle == nullptr) return nullptr;
+  napi_value result = nullptr;
+  napi_get_boolean(env, handle->database != nullptr, &result);
+  return result;
+}
+
+napi_value DatabaseClose(napi_env env, napi_callback_info info) {
+  size_t argc = 0;
+  napi_value self = nullptr;
+  if (napi_get_cb_info(env, info, &argc, nullptr, &self, nullptr) != napi_ok) {
+    return nullptr;
+  }
+  DatabaseHandle* handle = UnwrapDatabase(env, self, false);
+  if (handle == nullptr) return nullptr;
+  if (handle->database == nullptr) {
+    ThrowInvalidState(env, "The database is not open");
+    return nullptr;
+  }
+  FinalizeDatabaseStatements(env, handle);
+  const int result = sqlite3_close_v2(handle->database);
+  if (result != SQLITE_OK) {
+    ThrowSqliteError(env, handle->database, result,
+                     "Could not close database");
+    return nullptr;
+  }
+  handle->database = nullptr;
+  return Undefined(env);
+}
+
+napi_value DatabaseExec(napi_env env, napi_callback_info info) {
+  size_t argc = 1;
+  napi_value argv[1] = {nullptr};
+  napi_value self = nullptr;
+  if (napi_get_cb_info(env, info, &argc, argv, &self, nullptr) != napi_ok ||
+      argc < 1 || argv[0] == nullptr) {
+    napi_throw_type_error(
+        env, "ERR_INVALID_ARG_TYPE",
+        "DatabaseSync.exec requires SQL text");
+    return nullptr;
+  }
+  DatabaseHandle* handle = UnwrapDatabase(env, self);
+  if (handle == nullptr) return nullptr;
+  napi_valuetype type = napi_undefined;
+  if (napi_typeof(env, argv[0], &type) != napi_ok || type != napi_string) {
+    napi_throw_type_error(
+        env, "ERR_INVALID_ARG_TYPE",
+        "DatabaseSync.exec SQL must be a string");
+    return nullptr;
+  }
+  const std::string sql = ValueToUtf8(env, argv[0]);
+  char* error = nullptr;
+  const int result =
+      sqlite3_exec(handle->database, sql.c_str(), nullptr, nullptr, &error);
+  if (result != SQLITE_OK) {
+    std::string message = "SQLite exec failed";
+    if (error != nullptr) {
+      message.append(": ");
+      message.append(error);
+      sqlite3_free(error);
+    }
+    napi_throw_error(env, "ERR_SQLITE_ERROR", message.c_str());
+    return nullptr;
+  }
+  return Undefined(env);
+}
+
+napi_value DatabasePrepare(napi_env env, napi_callback_info info) {
+  size_t argc = 1;
+  napi_value argv[1] = {nullptr};
+  napi_value self = nullptr;
+  if (napi_get_cb_info(env, info, &argc, argv, &self, nullptr) != napi_ok ||
+      argc < 1 || argv[0] == nullptr) {
+    napi_throw_type_error(
+        env, "ERR_INVALID_ARG_TYPE",
+        "DatabaseSync.prepare requires SQL text");
+    return nullptr;
+  }
+  DatabaseHandle* handle = UnwrapDatabase(env, self);
+  if (handle == nullptr) return nullptr;
+  napi_valuetype type = napi_undefined;
+  if (napi_typeof(env, argv[0], &type) != napi_ok || type != napi_string) {
+    napi_throw_type_error(
+        env, "ERR_INVALID_ARG_TYPE",
+        "DatabaseSync.prepare SQL must be a string");
+    return nullptr;
+  }
+  const std::string sql = ValueToUtf8(env, argv[0]);
+  auto* statement = new StatementHandle();
+  statement->owner = handle;
+  const int result = sqlite3_prepare_v2(
+      handle->database, sql.c_str(), static_cast<int>(sql.size()),
+      &statement->statement, nullptr);
+  if (result != SQLITE_OK || statement->statement == nullptr) {
+    ThrowSqliteError(env, handle->database, result,
+                     "Could not prepare statement");
+    if (statement->statement != nullptr) sqlite3_finalize(statement->statement);
+    delete statement;
+    return nullptr;
+  }
+  if (napi_create_reference(env, self, 1, &statement->owner_reference) !=
+      napi_ok) {
+    sqlite3_finalize(statement->statement);
+    delete statement;
+    return nullptr;
+  }
+
+  napi_value constructor = nullptr;
+  napi_value external = nullptr;
+  napi_value instance = nullptr;
+  if (handle->binding == nullptr ||
+      handle->binding->statement_constructor == nullptr ||
+      napi_get_reference_value(
+          env, handle->binding->statement_constructor, &constructor) !=
+          napi_ok ||
+      constructor == nullptr ||
+      napi_create_external(
+          env, statement, nullptr, nullptr, &external) != napi_ok ||
+      external == nullptr ||
+      napi_new_instance(
+          env, constructor, 1, &external, &instance) != napi_ok ||
+      instance == nullptr) {
+    StatementFinalize(env, statement, nullptr);
+    return nullptr;
+  }
+  handle->statements.insert(statement);
+  return instance;
+}
