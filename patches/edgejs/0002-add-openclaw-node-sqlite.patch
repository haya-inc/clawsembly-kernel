+napi_value InitSqlite(napi_env env) {
+  napi_value binding = nullptr;
+  if (napi_create_object(env, &binding) != napi_ok || binding == nullptr) {
+    return Undefined(env);
+  }
+  auto* state = new BindingState();
+
+  const napi_property_descriptor statement_properties[] = {
+      {"all", nullptr, StatementAll, nullptr, nullptr, nullptr,
+       napi_default_method, nullptr},
+      {"columns", nullptr, StatementColumns, nullptr, nullptr, nullptr,
+       napi_default_method, nullptr},
+      {"get", nullptr, StatementGet, nullptr, nullptr, nullptr,
+       napi_default_method, nullptr},
+      {"iterate", nullptr, StatementIterate, nullptr, nullptr, nullptr,
+       napi_default_method, nullptr},
+      {"run", nullptr, StatementRun, nullptr, nullptr, nullptr,
+       napi_default_method, nullptr},
+  };
+  napi_value statement_constructor = nullptr;
+  if (napi_define_class(
+          env, "StatementSync", NAPI_AUTO_LENGTH, StatementCtor, state,
+          sizeof(statement_properties) / sizeof(statement_properties[0]),
+          statement_properties, &statement_constructor) != napi_ok ||
+      statement_constructor == nullptr ||
+      napi_create_reference(
+          env, statement_constructor, 1,
+          &state->statement_constructor) != napi_ok) {
+    delete state;
+    return Undefined(env);
+  }
+
+  const napi_property_descriptor database_properties[] = {
+      {"close", nullptr, DatabaseClose, nullptr, nullptr, nullptr,
+       napi_default_method, nullptr},
+      {"enableLoadExtension", nullptr, DatabaseEnableLoadExtension, nullptr,
+       nullptr, nullptr, napi_default_method, nullptr},
+      {"exec", nullptr, DatabaseExec, nullptr, nullptr, nullptr,
+       napi_default_method, nullptr},
+      {"isOpen", nullptr, nullptr, DatabaseIsOpen, nullptr, nullptr,
+       napi_default, nullptr},
+      {"loadExtension", nullptr, ExtensionUnavailable, nullptr, nullptr,
+       nullptr, napi_default_method, nullptr},
+      {"prepare", nullptr, DatabasePrepare, nullptr, nullptr, nullptr,
+       napi_default_method, nullptr},
+  };
+  napi_value database_constructor = nullptr;
+  if (napi_define_class(
+          env, "DatabaseSync", NAPI_AUTO_LENGTH, DatabaseCtor, state,
+          sizeof(database_properties) / sizeof(database_properties[0]),
+          database_properties, &database_constructor) != napi_ok ||
+      database_constructor == nullptr ||
+      napi_create_reference(
+          env, database_constructor, 1,
+          &state->database_constructor) != napi_ok ||
+      napi_set_named_property(
+          env, binding, "DatabaseSync", database_constructor) != napi_ok ||
+      napi_set_named_property(
+          env, binding, "StatementSync", statement_constructor) != napi_ok ||
+      napi_wrap(
+          env, binding, state, BindingFinalize, nullptr, nullptr) != napi_ok) {
+    if (state->database_constructor != nullptr) {
+      napi_delete_reference(env, state->database_constructor);
+    }
+    if (state->statement_constructor != nullptr) {
+      napi_delete_reference(env, state->statement_constructor);
+    }
+    delete state;
+    return Undefined(env);
+  }
+  return binding;
+}
+
+}  // namespace internal_binding
+
+#endif  // defined(EDGE_HAS_SQLITE)
diff --git i/tests/js/openclaw-sqlite-contract.js w/tests/js/openclaw-sqlite-contract.js
new file mode 100644
index 0000000000000000000000000000000000000000..05b3828b9f708f0694fa79a86c1837ee2db47cc6
--- /dev/null
+++ w/tests/js/openclaw-sqlite-contract.js
@@ -0,0 +1,168 @@
+'use strict';
+
+const fs = require('node:fs');
+const { DatabaseSync } = require('node:sqlite');
+
+function check(condition, message) {
+  if (!condition) throw new Error(message);
+}
+
+const databasePath = process.argv[2] || '/tmp/edge-openclaw-sqlite-contract.db';
+for (const suffix of ['', '-shm', '-wal']) {
+  try {
+    fs.unlinkSync(databasePath + suffix);
+  } catch (error) {
+    if (error?.code !== 'ENOENT') throw error;
+  }
+}
+
+const database = new DatabaseSync(databasePath, { timeout: 1000 });
+check(database.isOpen === true, 'database should open');
+check(
+  database.prepare('SELECT sqlite_version() AS version').get().version ===
+    '3.53.4',
+  'unexpected SQLite version'
+);
+check(
+  database.prepare('PRAGMA foreign_keys').get().foreign_keys === 1,
+  'foreign key enforcement should default on'
+);
+check(
+  database.prepare('PRAGMA locking_mode').get().locking_mode === 'normal',
+  'native database should retain normal locking mode'
+);
+check(
+  database.prepare('PRAGMA journal_mode = WAL').get().journal_mode === 'wal',
+  'file database should enter WAL mode'
+);
+database.exec(`
+  PRAGMA busy_timeout = 1000;
+  PRAGMA synchronous = NORMAL;
+  CREATE TABLE parents (
+    id INTEGER PRIMARY KEY,
+    label TEXT NOT NULL UNIQUE
+  );
+  CREATE TABLE children (
+    id INTEGER PRIMARY KEY,
+    parent_id INTEGER NOT NULL REFERENCES parents(id),
+    payload BLOB
+  );
+`);
+
+const insertParent =
+  database.prepare('INSERT INTO parents(label) VALUES ($label)');
+check(insertParent.run({ $label: 'alpha' }).changes === 1, 'named insert');
+check(insertParent.run({ label: 'beta' }).changes === 1, 'bare named insert');
+
+database.exec('BEGIN IMMEDIATE');
+database.prepare(
+  'INSERT INTO children(parent_id, payload) VALUES (?, ?)'
+).run(1, new Uint8Array([1, 2, 3]));
+database.exec('SAVEPOINT nested');
+database.prepare(
+  'INSERT INTO children(parent_id, payload) VALUES (?, ?)'
+).run(2, new Uint8Array([4, 5]));
+database.exec('ROLLBACK TO nested; RELEASE nested; COMMIT');
+
+const rows = database.prepare(`
+  SELECT parents.label, children.payload
+  FROM children
+  JOIN parents ON parents.id = children.parent_id
+  ORDER BY children.id
+`).all();
+check(rows.length === 1 && rows[0].label === 'alpha', 'transaction rows');
+check(
+  rows[0].payload instanceof Uint8Array &&
+    Array.from(rows[0].payload).join(',') === '1,2,3',
+  'blob round trip'
+);
+
+const iterated = Array.from(
+  database.prepare('SELECT label FROM parents ORDER BY id').iterate()
+);
+check(
+  JSON.stringify(iterated) ===
+    JSON.stringify([{ label: 'alpha' }, { label: 'beta' }]),
+  'iterator results'
+);
+
+const columns = database.prepare(
+  'SELECT id, label FROM parents ORDER BY id'
+).columns();
+check(
+  columns.length === 2 &&
+    columns[0].column === 'id' &&
+    columns[1].column === 'label',
+  'column metadata'
+);
+
+let foreignKeyRejected = false;
+try {
+  database.prepare(
+    'INSERT INTO children(parent_id, payload) VALUES (?, ?)'
+  ).run(999, null);
+} catch (error) {
+  foreignKeyRejected = error?.code === 'ERR_SQLITE_ERROR';
+}
+check(foreignKeyRejected, 'foreign key violation should fail');
+
+database.enableLoadExtension(false);
+let extensionRejected = false;
+try {
+  database.enableLoadExtension(true);
+} catch (error) {
+  extensionRejected = error?.code === 'ERR_FEATURE_UNAVAILABLE';
+}
+check(extensionRejected, 'extension loading must fail explicitly');
+
+const checkpoint = database.prepare('PRAGMA wal_checkpoint(TRUNCATE)').get();
+check(
+  typeof checkpoint.busy === 'number' &&
+    typeof checkpoint.log === 'number' &&
+    typeof checkpoint.checkpointed === 'number',
+  'WAL checkpoint result'
+);
+database.close();
+check(database.isOpen === false, 'database should close');
+let finalizedStatementRejected = false;
+try {
+  insertParent.run({ label: 'after-close' });
+} catch (error) {
+  finalizedStatementRejected = error?.code === 'ERR_INVALID_STATE';
+}
+check(
+  finalizedStatementRejected,
+  'database close should finalize every retained statement'
+);
+let duplicateCloseRejected = false;
+try {
+  database.close();
+} catch (error) {
+  duplicateCloseRejected = error?.code === 'ERR_INVALID_STATE';
+}
+check(duplicateCloseRejected, 'closing a closed database should fail');
+
+const readOnly = new DatabaseSync(databasePath, { readOnly: true });
+check(
+  readOnly.prepare('SELECT count(*) AS count FROM parents').get().count === 2,
+  'read-only persistence'
+);
+let writeRejected = false;
+try {
+  readOnly.prepare('INSERT INTO parents(label) VALUES (?)').run('gamma');
+} catch (error) {
+  writeRejected = error?.code === 'ERR_SQLITE_ERROR';
+}
+check(writeRejected, 'read-only write should fail');
+readOnly.close();
+
+console.log(JSON.stringify({
+  databasePath,
+  sqliteVersion: '3.53.4',
+  wal: true,
+  persistence: true,
+  statementFinalization: true,
+  readOnly: true,
+  extensionLoading: false,
+  status: 'pass'
+}));
