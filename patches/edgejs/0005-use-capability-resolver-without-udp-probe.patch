@@ -191,6 +191,15 @@ int uv_getaddrinfo(uv_loop_t* loop,
 
   if (hints) {
     req->hints = memcpy(buf + len, hints, sizeof(*hints));
+#if defined(__wasi__)
+    /*
+     * musl implements AI_ADDRCONFIG by opening and connecting UDP sockets.
