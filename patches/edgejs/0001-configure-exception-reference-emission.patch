+        JSContext *ctx = env->context();
+        JSValue exception = JS_NewInternalError(ctx, "execution terminated");
+        if (JS_IsException(exception))
+            return napi_util__::return_pending_if_caught(
+                env, ctx, "Failed to create execution termination exception");
+
+        // QuickJS interruption errors are uncatchable. Deliver the equivalent
+        // immediately through the N-API callback trampoline instead of waiting
+        // for the bytecode interrupt counter, so process.exit() cannot execute
+        // subsequent user code.
+        JS_SetUncatchableError(ctx, exception);
+        env->set_execution_termination_exception(exception);
+        return napi_ok;
