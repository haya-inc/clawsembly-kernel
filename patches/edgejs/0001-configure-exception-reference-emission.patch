+void napi_env__::cancel_execution_termination()
+{
+  if (!execution_termination_pending_)
+    return;
+
+  if (has_last_exception_)
+  {
+    JSContext *ctx = last_exception_context_ == nullptr ? main_context_ : last_exception_context_;
+    JS_ClearUncatchableError(ctx, last_exception_);
+  }
+  clear_last_exception();
+}
