@@ -0,0 +1,89 @@
+#include "test_env.h"
+
+#include "unofficial_napi.h"
+
+class Test66UnofficialTermination : public FixtureTestBase {};
+
+namespace {
+
+napi_value Terminate(napi_env env, napi_callback_info /*info*/) {
+  EXPECT_EQ(unofficial_napi_terminate_execution(env), napi_ok);
+  return nullptr;
+}
+
+napi_value TerminateAndCancel(napi_env env, napi_callback_info /*info*/) {
+  EXPECT_EQ(unofficial_napi_terminate_execution(env), napi_ok);
+  EXPECT_EQ(unofficial_napi_cancel_terminate_execution(env), napi_ok);
+  return nullptr;
+}
+
+void InstallGlobalFunction(napi_env env, const char* name, napi_callback callback) {
+  napi_value global = nullptr;
+  ASSERT_EQ(napi_get_global(env, &global), napi_ok);
+  ASSERT_NE(global, nullptr);
+
+  napi_value function = nullptr;
+  ASSERT_EQ(napi_create_function(
+                env, name, NAPI_AUTO_LENGTH, callback, nullptr, &function),
+            napi_ok);
+  ASSERT_NE(function, nullptr);
+  ASSERT_EQ(napi_set_named_property(env, global, name, function), napi_ok);
+}
+
+bool GlobalBool(napi_env env, const char* name) {
+  napi_value global = nullptr;
+  EXPECT_EQ(napi_get_global(env, &global), napi_ok);
+  napi_value value = nullptr;
+  EXPECT_EQ(napi_get_named_property(env, global, name, &value), napi_ok);
+  bool result = false;
+  EXPECT_EQ(napi_get_value_bool(env, value, &result), napi_ok);
+  return result;
+}
+
+napi_status RunScript(napi_env env, const char* source) {
+  napi_value script = nullptr;
+  if (napi_create_string_utf8(env, source, NAPI_AUTO_LENGTH, &script) != napi_ok)
+    return napi_generic_failure;
+  napi_value result = nullptr;
+  return napi_run_script(env, script, &result);
+}
+
+}  // namespace
+
+TEST_F(Test66UnofficialTermination, ImmediatelyUnwindsAndCannotBeCaught) {
+  EnvScope s(runtime_.get());
+  InstallGlobalFunction(s.env, "terminateForTest", Terminate);
+
+  EXPECT_EQ(
+      RunScript(s.env,
+          "globalThis.afterTerminate = false;"
+          "globalThis.caughtTerminate = false;"
+          "try {"
+          "  terminateForTest();"
+          "  globalThis.afterTerminate = true;"
+          "} catch {"
+          "  globalThis.caughtTerminate = true;"
+          "}"),
+      napi_pending_exception);
+
+  napi_value exception = nullptr;
+  ASSERT_EQ(napi_get_and_clear_last_exception(s.env, &exception), napi_ok);
+  ASSERT_NE(exception, nullptr);
+  EXPECT_EQ(unofficial_napi_cancel_terminate_execution(s.env), napi_ok);
+
+  EXPECT_FALSE(GlobalBool(s.env, "afterTerminate"));
+  EXPECT_FALSE(GlobalBool(s.env, "caughtTerminate"));
+}
+
+TEST_F(Test66UnofficialTermination, CancelBeforeDeliveryAllowsExecutionToContinue) {
+  EnvScope s(runtime_.get());
+  InstallGlobalFunction(s.env, "terminateAndCancelForTest", TerminateAndCancel);
+
+  EXPECT_EQ(
+      RunScript(s.env,
+          "globalThis.afterCancelledTerminate = false;"
+          "terminateAndCancelForTest();"
+          "globalThis.afterCancelledTerminate = true;"),
+      napi_ok);
+  EXPECT_TRUE(GlobalBool(s.env, "afterCancelledTerminate"));
+}
