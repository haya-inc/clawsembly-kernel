diff --git a/src/syscalls/wasix/thread_spawn.rs b/src/syscalls/wasix/thread_spawn.rs
--- a/src/syscalls/wasix/thread_spawn.rs
+++ b/src/syscalls/wasix/thread_spawn.rs
@@ -212,9 +212,22 @@ fn call_module_internal<M: MemorySize>(
     );
     trace!("callback finished (ret={:?})", thread_result);
 
+    let successful_child_exit = matches!(
+        &thread_result,
+        Err(err)
+            if matches!(
+                err.downcast_ref::<WasiError>(),
+                Some(WasiError::Exit(code)) if code.is_success()
+            )
+    );
     let exit_code = handle_thread_result(env, store, thread_result)?;
 
-    // Clean up the environment on exit
-    env.on_exit(store, exit_code);
+    // WASIX libc can surface a successful child-thread trampoline as Exit(0).
+    // Keep that completion entirely local. WasiFunctionEnv::on_exit() also
+    // shuts down the linker instance group, so calling it with None can still
+    // terminate the main process even when no process exit code is propagated.
+    if !successful_child_exit {
+        env.on_exit(store, exit_code);
+    }
     Ok(())
 }
