From 9303e572a2e1f70b60e2efc55668d3718f63e1e5 Mon Sep 17 00:00:00 2001
Subject: [PATCH] fix(wasix): use write readiness for writes

Backport of the implementation fix from:
https://github.com/wasmerio/wasmer/pull/6297
https://github.com/wasmerio/wasmer/commit/9303e572a2e1f70b60e2efc55668d3718f63e1e5

The upstream unit regression is represented in Clawsembly by the
CPU-throttled, cross-guest browser loopback proof.
---
 src/net/socket.rs | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/net/socket.rs b/src/net/socket.rs
--- a/src/net/socket.rs
+++ b/src/net/socket.rs
@@ -229,7 +229,7 @@ impl InodeSocket {
 
     pub fn poll_write_ready(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<io::Result<usize>> {
         let mut inner = self.inner.protected.write().unwrap();
-        inner.poll_read_ready(cx)
+        inner.poll_write_ready(cx)
     }
 
     // When a sendto or connect call comes in for a UDP "pre-socket", it must be bound to
