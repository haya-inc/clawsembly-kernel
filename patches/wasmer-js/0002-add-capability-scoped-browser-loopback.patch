index 0000000..0296429
--- /dev/null
+++ w/src/browser_network.rs
@@ -0,0 +1,555 @@
+use std::{
+    collections::{HashMap, HashSet},
+    mem::MaybeUninit,
+    net::{IpAddr, Ipv4Addr, Ipv6Addr, SocketAddr},
+    sync::{Arc, Mutex},
+    task::{Context, Poll},
+    time::Duration,
+};
+
+use serde::Deserialize;
+use virtual_net::{
+    InterestHandler, IpCidr, LoopbackNetworking, NetworkError, SocketStatus,
+    VirtualConnectedSocket, VirtualIoSource, VirtualNetworking, VirtualSocket, VirtualTcpListener,
+    VirtualTcpSocket,
+};
+
+/// A browser-local TCP namespace plus optional, explicitly-scoped egress.
+#[derive(Clone, Debug, Default)]
+pub(crate) struct BrowserNetworking {
+    loopback: LoopbackNetworking,
+    listeners: Arc<Mutex<HashSet<SocketAddr>>>,
+    egress: Option<BrowserEgress>,
+}
+
+#[derive(Clone, Debug)]
+struct BrowserEgress {
+    remote: Arc<dyn VirtualNetworking>,
+    rules: Arc<HashMap<(String, u16), NetworkEgressRule>>,
+    resolved: Arc<Mutex<HashMap<(String, u16), HashSet<IpAddr>>>>,
+}
+
+#[derive(Clone, Debug, Deserialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub(crate) struct NetworkEgressCapability {
+    pub(crate) gateway_url: String,
+    pub(crate) gateway_token: String,
+    pub(crate) allow: Vec<NetworkEgressRule>,
+}
+
+#[derive(Clone, Debug, Deserialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub(crate) struct NetworkEgressRule {
+    pub(crate) host: String,
+    pub(crate) port: u16,
+    #[serde(default)]
+    pub(crate) allow_private_network: bool,
+}
+
+impl NetworkEgressCapability {
+    pub(crate) fn validate(mut self) -> anyhow::Result<Self> {
+        let gateway = url::Url::parse(&self.gateway_url)?;
+        let is_loopback_gateway = match gateway.host() {
+            Some(url::Host::Domain(host)) => host.eq_ignore_ascii_case("localhost"),
+            Some(url::Host::Ipv4(address)) => address.is_loopback(),
+            Some(url::Host::Ipv6(address)) => address.is_loopback(),
+            None => false,
+        };
+        if !matches!(gateway.scheme(), "ws" | "wss")
+            || gateway.host_str().is_none()
+            || gateway.cannot_be_a_base()
+            || !gateway.username().is_empty()
+            || gateway.password().is_some()
+            || gateway.query().is_some()
+            || gateway.fragment().is_some()
+        {
+            anyhow::bail!(
+                "networkEgress.gatewayUrl must be an absolute ws: or wss: URL without credentials, query, or fragment"
+            );
+        }
+        if gateway.scheme() == "ws" && !is_loopback_gateway {
+            anyhow::bail!("networkEgress.gatewayUrl must use wss: unless the relay is on loopback");
+        }
+        if self.gateway_token.is_empty()
+            || self.gateway_token.len() > 128
+            || !self
+                .gateway_token
+                .bytes()
+                .all(|byte| byte.is_ascii_alphanumeric() || matches!(byte, b'-' | b'_' | b'.'))
+        {
+            anyhow::bail!("networkEgress.gatewayToken must be 1-128 URL-safe protocol characters");
+        }
+        if self.allow.is_empty() {
+            anyhow::bail!("networkEgress.allow must contain at least one host and port");
+        }
+
+        let mut unique = HashSet::new();
+        for rule in &mut self.allow {
+            rule.host = normalize_hostname(&rule.host)?;
+            if rule.port == 0 {
+                anyhow::bail!("networkEgress.allow ports must be between 1 and 65535");
+            }
+            if !unique.insert((rule.host.clone(), rule.port)) {
+                anyhow::bail!(
+                    "networkEgress.allow contains a duplicate host and port: {}:{}",
+                    rule.host,
+                    rule.port
+                );
+            }
+        }
+        Ok(self)
+    }
+}
+
+impl BrowserNetworking {
+    pub(crate) fn with_egress(
+        remote: Arc<dyn VirtualNetworking>,
+        rules: Vec<NetworkEgressRule>,
+    ) -> Self {
+        let rules = rules
+            .into_iter()
+            .map(|rule| ((rule.host.clone(), rule.port), rule))
+            .collect();
+        Self {
+            egress: Some(BrowserEgress {
+                remote,
+                rules: Arc::new(rules),
+                resolved: Arc::default(),
+            }),
+            ..Self::default()
+        }
+    }
+
+    fn is_loopback(address: SocketAddr) -> bool {
+        address.ip().is_loopback()
+    }
+
+    fn is_resolved_egress(&self, peer_address: SocketAddr) -> bool {
+        self.egress.as_ref().is_some_and(|egress| {
+            egress
+                .resolved
+                .lock()
+                .unwrap()
+                .iter()
+                .any(|((_, port), addresses)| {
+                    *port == peer_address.port() && addresses.contains(&peer_address.ip())
+                })
+        })
+    }
+}
+
+#[async_trait::async_trait]
+impl VirtualNetworking for BrowserNetworking {
+    async fn dhcp_acquire(&self) -> virtual_net::Result<Vec<IpAddr>> {
+        self.loopback.dhcp_acquire().await
+    }
+
+    async fn ip_add(&self, ip: IpAddr, prefix: u8) -> virtual_net::Result<()> {
+        if !ip.is_loopback() {
+            return Err(NetworkError::PermissionDenied);
+        }
+        self.loopback.ip_add(ip, prefix).await
+    }
+
+    async fn ip_remove(&self, ip: IpAddr) -> virtual_net::Result<()> {
+        self.loopback.ip_remove(ip).await
+    }
+
+    async fn ip_clear(&self) -> virtual_net::Result<()> {
+        self.loopback.ip_clear().await
+    }
+
+    async fn ip_list(&self) -> virtual_net::Result<Vec<IpCidr>> {
+        self.loopback.ip_list().await
+    }
+
+    async fn listen_tcp(
+        &self,
+        address: SocketAddr,
+        only_v6: bool,
+        reuse_port: bool,
+        reuse_addr: bool,
+    ) -> virtual_net::Result<Box<dyn VirtualTcpListener + Sync>> {
+        if !Self::is_loopback(address) {
+            return Err(NetworkError::PermissionDenied);
+        }
+        {
+            let mut listeners = self.listeners.lock().unwrap();
+            if !listeners.insert(address) {
+                return Err(NetworkError::AddressInUse);
+            }
+        }
+        match self
+            .loopback
+            .listen_tcp(address, only_v6, reuse_port, reuse_addr)
+            .await
+        {
+            Ok(inner) => Ok(Box::new(TrackedTcpListener {
+                address,
+                inner,
+                listeners: self.listeners.clone(),
+            })),
+            Err(error) => {
+                self.listeners.lock().unwrap().remove(&address);
+                Err(error)
+            }
+        }
+    }
+
+    async fn connect_tcp(
+        &self,
+        local_address: SocketAddr,
+        peer_address: SocketAddr,
+    ) -> virtual_net::Result<Box<dyn VirtualTcpSocket + Sync>> {
+        if !Self::is_loopback(peer_address) {
+            let egress = self.egress.as_ref().ok_or(NetworkError::PermissionDenied)?;
+            if !self.is_resolved_egress(peer_address) {
+                return Err(NetworkError::PermissionDenied);
+            }
+            let result = egress.remote.connect_tcp(local_address, peer_address).await;
+            return result.map(connected_egress_socket);
+        }
+        if self.listeners.lock().unwrap().contains(&peer_address) {
+            return self
+                .loopback
+                .loopback_connect_to(local_address, peer_address)
+                .map(|socket| Box::new(socket) as Box<dyn VirtualTcpSocket + Sync>)
+                .ok_or(NetworkError::ConnectionRefused);
+        }
+        if self.is_resolved_egress(peer_address) {
+            let result = self
+                .egress
+                .as_ref()
+                .unwrap()
+                .remote
+                .connect_tcp(local_address, peer_address)
+                .await;
+            return result.map(connected_egress_socket);
+        }
+        Err(NetworkError::ConnectionRefused)
+    }
+
+    async fn resolve(
+        &self,
+        host: &str,
+        port: Option<u16>,
+        dns_server: Option<IpAddr>,
+    ) -> virtual_net::Result<Vec<IpAddr>> {
+        if dns_server.is_some() {
+            return Err(NetworkError::PermissionDenied);
+        }
+        if let Ok(ip) = host.parse::<IpAddr>() {
+            return if ip.is_loopback() {
+                Ok(vec![ip])
+            } else {
+                Err(NetworkError::PermissionDenied)
+            };
+        }
+
+        let normalized = normalize_hostname(host).map_err(|_| NetworkError::InvalidInput)?;
+        let Some(egress) = self.egress.as_ref() else {
+            return if normalized == "localhost" {
+                Ok(vec![
+                    IpAddr::V4(Ipv4Addr::LOCALHOST),
+                    IpAddr::V6(Ipv6Addr::LOCALHOST),
+                ])
+            } else {
+                Err(NetworkError::PermissionDenied)
+            };
+        };
+        let matching_rules = egress
+            .rules
+            .iter()
+            .filter(|((allowed_host, _), _)| *allowed_host == normalized)
+            .collect::<Vec<_>>();
+        if normalized == "localhost" && matching_rules.is_empty() {
+            return Ok(vec![
+                IpAddr::V4(Ipv4Addr::LOCALHOST),
+                IpAddr::V6(Ipv6Addr::LOCALHOST),
+            ]);
+        }
+        if matching_rules.is_empty() {
+            return Err(NetworkError::PermissionDenied);
+        }
+        let addresses = egress.remote.resolve(&normalized, port, None).await?;
+        let mut returned = HashSet::new();
+        let mut resolved = egress.resolved.lock().unwrap();
+        for (key, rule) in matching_rules {
+            let allowed = addresses
+                .iter()
+                .copied()
+                .filter(|address| rule.allow_private_network || is_public_address(*address))
+                .collect::<HashSet<_>>();
+            returned.extend(allowed.iter().copied());
+            resolved.insert(key.clone(), allowed);
+        }
+        if returned.is_empty() {
+            return Err(NetworkError::PermissionDenied);
+        }
+        Ok(returned.into_iter().collect())
+    }
+}
+
+fn connected_egress_socket(
+    inner: Box<dyn VirtualTcpSocket + Sync>,
+) -> Box<dyn VirtualTcpSocket + Sync> {
+    Box::new(ConnectedEgressTcpSocket {
+        inner,
+        initial_write_ready: true,
+        write_blocked: false,
+        eof: false,
+    })
+}
+
+#[derive(Debug)]
+struct ConnectedEgressTcpSocket {
+    inner: Box<dyn VirtualTcpSocket + Sync>,
+    initial_write_ready: bool,
+    write_blocked: bool,
+    eof: bool,
+}
+
+impl VirtualIoSource for ConnectedEgressTcpSocket {
+    fn remove_handler(&mut self) {
+        self.inner.remove_handler();
+    }
+
+    fn poll_read_ready(&mut self, context: &mut Context<'_>) -> Poll<virtual_net::Result<usize>> {
+        let result = self.inner.poll_read_ready(context);
+        if matches!(result, Poll::Ready(Ok(0))) {
+            self.eof = true;
+        }
+        result
+    }
+
+    fn poll_write_ready(&mut self, context: &mut Context<'_>) -> Poll<virtual_net::Result<usize>> {
+        if self.initial_write_ready {
+            self.initial_write_ready = false;
+            return Poll::Ready(Ok(64 * 1024));
+        }
+        if !self.write_blocked {
+            return Poll::Pending;
+        }
+        let result = self.inner.poll_write_ready(context);
+        if result.is_ready() {
+            self.write_blocked = false;
+        }
+        result
+    }
+}
+
+impl VirtualSocket for ConnectedEgressTcpSocket {
+    fn set_ttl(&mut self, ttl: u32) -> virtual_net::Result<()> {
+        self.inner.set_ttl(ttl)
+    }
+
+    fn ttl(&self) -> virtual_net::Result<u32> {
+        self.inner.ttl()
+    }
+
+    fn addr_local(&self) -> virtual_net::Result<SocketAddr> {
+        self.inner.addr_local()
+    }
+
+    fn status(&self) -> virtual_net::Result<SocketStatus> {
+        self.inner.status()
+    }
+
+    fn set_handler(
+        &mut self,
+        handler: Box<dyn InterestHandler + Send + Sync>,
+    ) -> virtual_net::Result<()> {
+        self.inner.set_handler(handler)
+    }
+}
+
+impl VirtualConnectedSocket for ConnectedEgressTcpSocket {
+    fn set_linger(&mut self, linger: Option<Duration>) -> virtual_net::Result<()> {
+        self.inner.set_linger(linger)
+    }
+
+    fn linger(&self) -> virtual_net::Result<Option<Duration>> {
+        self.inner.linger()
+    }
+
+    fn try_send(&mut self, data: &[u8]) -> virtual_net::Result<usize> {
+        let result = self.inner.try_send(data);
+        self.write_blocked = matches!(result, Err(NetworkError::WouldBlock));
+        result
+    }
+
+    fn try_flush(&mut self) -> virtual_net::Result<()> {
+        let result = self.inner.try_flush();
+        self.write_blocked = matches!(result, Err(NetworkError::WouldBlock));
+        result
+    }
+
+    fn close(&mut self) -> virtual_net::Result<()> {
+        self.inner.close()
+    }
+
+    fn try_recv(
+        &mut self,
+        buffer: &mut [MaybeUninit<u8>],
+        peek: bool,
+    ) -> virtual_net::Result<usize> {
+        if self.eof {
+            Ok(0)
+        } else {
+            self.inner.try_recv(buffer, peek)
+        }
+    }
+}
+
+impl VirtualTcpSocket for ConnectedEgressTcpSocket {
+    fn set_recv_buf_size(&mut self, size: usize) -> virtual_net::Result<()> {
+        self.inner.set_recv_buf_size(size)
+    }
+
+    fn recv_buf_size(&self) -> virtual_net::Result<usize> {
+        self.inner.recv_buf_size()
+    }
+
+    fn set_send_buf_size(&mut self, size: usize) -> virtual_net::Result<()> {
+        self.inner.set_send_buf_size(size)
+    }
+
+    fn send_buf_size(&self) -> virtual_net::Result<usize> {
+        self.inner.send_buf_size()
+    }
+
+    fn set_nodelay(&mut self, reuse: bool) -> virtual_net::Result<()> {
+        self.inner.set_nodelay(reuse)
+    }
+
+    fn nodelay(&self) -> virtual_net::Result<bool> {
+        self.inner.nodelay()
+    }
+
+    fn set_keepalive(&mut self, keepalive: bool) -> virtual_net::Result<()> {
+        self.inner.set_keepalive(keepalive)
+    }
+
+    fn keepalive(&self) -> virtual_net::Result<bool> {
+        self.inner.keepalive()
+    }
+
+    fn set_dontroute(&mut self, dont_route: bool) -> virtual_net::Result<()> {
+        self.inner.set_dontroute(dont_route)
+    }
+
+    fn dontroute(&self) -> virtual_net::Result<bool> {
+        self.inner.dontroute()
+    }
+
+    fn addr_peer(&self) -> virtual_net::Result<SocketAddr> {
+        self.inner.addr_peer()
+    }
+
+    fn shutdown(&mut self, how: std::net::Shutdown) -> virtual_net::Result<()> {
+        self.inner.shutdown(how)
+    }
+
+    fn is_closed(&self) -> bool {
+        self.inner.is_closed()
+    }
+}
+
+fn normalize_hostname(host: &str) -> anyhow::Result<String> {
+    let host = host.strip_suffix('.').unwrap_or(host);
+    match url::Host::parse(host)? {
+        url::Host::Domain(domain) if !domain.is_empty() && !domain.contains('*') => {
+            Ok(domain.to_ascii_lowercase())
+        }
+        _ => anyhow::bail!("network egress hosts must be exact DNS names"),
+    }
+}
+
+fn is_public_address(address: IpAddr) -> bool {
+    match address {
+        IpAddr::V4(address) => {
+            let [a, b, c, _] = address.octets();
+            !(a == 0
+                || a == 10
+                || a == 127
+                || (a == 100 && (64..=127).contains(&b))
+                || (a == 169 && b == 254)
+                || (a == 172 && (16..=31).contains(&b))
+                || (a == 192 && b == 0 && c == 0)
+                || (a == 192 && b == 0 && c == 2)
+                || (a == 192 && b == 88 && c == 99)
+                || (a == 192 && b == 168)
+                || (a == 198 && (b == 18 || b == 19))
+                || (a == 198 && b == 51 && c == 100)
+                || (a == 203 && b == 0 && c == 113)
+                || a >= 224)
+        }
+        IpAddr::V6(address) => {
+            if let Some(mapped) = address.to_ipv4_mapped() {
+                return is_public_address(IpAddr::V4(mapped));
+            }
+            let segments = address.segments();
+            !(address.is_unspecified()
+                || address.is_loopback()
+                || address.is_multicast()
+                || (segments[0] & 0xfe00) == 0xfc00
+                || (segments[0] & 0xffc0) == 0xfe80
+                || (segments[0] & 0xffc0) == 0xfec0
+                || (segments[0] == 0x2001 && segments[1] == 0x0db8))
+        }
+    }
+}
+
+#[derive(Debug)]
+struct TrackedTcpListener {
+    address: SocketAddr,
+    inner: Box<dyn VirtualTcpListener + Sync>,
+    listeners: Arc<Mutex<HashSet<SocketAddr>>>,
+}
+
+impl Drop for TrackedTcpListener {
+    fn drop(&mut self) {
+        self.listeners.lock().unwrap().remove(&self.address);
+    }
+}
+
+impl VirtualIoSource for TrackedTcpListener {
+    fn remove_handler(&mut self) {
+        self.inner.remove_handler();
+    }
+
+    fn poll_read_ready(&mut self, context: &mut Context<'_>) -> Poll<virtual_net::Result<usize>> {
+        self.inner.poll_read_ready(context)
+    }
+
+    fn poll_write_ready(&mut self, context: &mut Context<'_>) -> Poll<virtual_net::Result<usize>> {
+        self.inner.poll_write_ready(context)
+    }
+}
+
+impl VirtualTcpListener for TrackedTcpListener {
+    fn try_accept(
+        &mut self,
+    ) -> virtual_net::Result<(Box<dyn VirtualTcpSocket + Sync>, SocketAddr)> {
+        self.inner.try_accept()
+    }
+
+    fn set_handler(
+        &mut self,
+        handler: Box<dyn InterestHandler + Send + Sync>,
+    ) -> virtual_net::Result<()> {
+        self.inner.set_handler(handler)
+    }
+
+    fn addr_local(&self) -> virtual_net::Result<SocketAddr> {
+        self.inner.addr_local()
+    }
+
+    fn set_ttl(&mut self, ttl: u8) -> virtual_net::Result<()> {
+        self.inner.set_ttl(ttl)
+    }
+
+    fn ttl(&self) -> virtual_net::Result<u8> {
+        self.inner.ttl()
+    }
+}
